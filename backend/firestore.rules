rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function member(rid) { return signedIn() && exists(/databases/$(database)/documents/restaurants/$(rid)/users/$(request.auth.uid)); }
    function role(rid) { return get(/databases/$(database)/documents/restaurants/$(rid)/users/$(request.auth.uid)).data.role; }
    function manager(rid) { return member(rid) && role(rid) in ['owner','manager']; }
    function owner(rid) { return member(rid) && role(rid) == 'owner'; }
    match /users/{uid} {
      allow read, create, update: if signedIn() && uid == request.auth.uid;
      allow delete: if false;
    }
    match /restaurants/{rid} {
      allow read: if member(rid); allow create: if signedIn(); allow update, delete: if owner(rid);
      match /users/{uid} {
        allow read: if member(rid);
        // A new account may only bootstrap its own owner profile. Owners provision all other staff profiles.
        allow create: if owner(rid) || (signedIn() && uid == request.auth.uid && request.resource.data.role == 'owner' && request.resource.data.restaurantId == rid);
        allow update: if owner(rid) || (signedIn() && uid == request.auth.uid && request.resource.data.role == resource.data.role);
        allow delete: if owner(rid);
      }
      match /{collection}/{doc} {
        allow read: if member(rid);
        allow create: if member(rid) && (collection in ['orders','customers','auditLogs'] || manager(rid));
        allow update: if manager(rid) || (member(rid) && collection == 'orders' && resource.data.waiterId == request.auth.uid);
        allow delete: if manager(rid);
      }
    }
  }
}
